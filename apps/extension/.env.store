# Public browser-store builds must remain credential-free. The extension routes
# through the L@tr.link same-site proxy, which injects its client credential on
# the server. These explicit empty values prevent local Production secrets from
# being serialized into WXT/Vite's import.meta.env object.
VITE_LATR_GATEWAY_URL=
VITE_LATR_APP_ENV=
VITE_LATR_GATEWAY_CLIENT_ID=
VITE_LATR_GATEWAY_API_KEY=
VITE_ATPROTO_CLIENT_ID=
VITE_ATPROTO_REDIRECT_URI=
VITE_LATR_WEB_URL=
